# --- App ---
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
APP_URL=http://localhost:3000
PUBLIC_APP_NAME="Simple Adaptable Storage"

# --- Database ---
DATABASE_URL=postgres://app:password@localhost:5432/sas

# --- Postgres (used by docker-compose) ---
POSTGRES_USER=app
POSTGRES_PASSWORD=password
POSTGRES_DB=sas
POSTGRES_DATA_DIR=./data/postgres

# --- BetterAuth ---
BETTER_AUTH_SECRET=change-me-to-a-32-char-random-string
BETTER_AUTH_URL=http://localhost:3000

# --- File storage ---
UPLOADS_DIR=./uploads
MAX_UPLOAD_BYTES=10485760
TOS_VERSION=1

# --- Mailer (SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=no-reply@example.com
SMTP_PASS=
SMTP_FROM="Simple Adaptable Storage <no-reply@example.com>"

# --- OpenAI (test grading) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Misc ---
TZ=Europe/Paris
