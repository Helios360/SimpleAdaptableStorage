# --- App ---
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
APP_URL=http://localhost:3000
PUBLIC_APP_NAME="CloudStudent"

# --- Database ---
DATABASE_URL=postgres://app:password@localhost:5432/cloudstudent

# --- Postgres (used to build DATABASE_URL in docker-compose; the DB itself is
# a shared instance reached via the external `dbnet` network) ---
POSTGRES_USER=app
POSTGRES_PASSWORD=password
POSTGRES_DB=cloudstudent
POSTGRES_DATA_DIR=./data/postgres

# --- BetterAuth ---
BETTER_AUTH_SECRET=change-me-to-a-32-char-random-string
BETTER_AUTH_URL=http://localhost:3000

# --- OpenAI (test generation + CV suggestions) ---
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# --- Email (Gmail API, compte de service + délégation à l'échelle du domaine) ---
# Si les 3 GMAIL_* sont remplies, l'app envoie les emails (reset mdp, etc.) via
# l'API Gmail. Sinon, driver "console" (les emails sont juste loggés).
GMAIL_SA_EMAIL=service-account@projet.iam.gserviceaccount.com
GMAIL_SENDER=no-reply@ton-domaine.fr
GMAIL_FROM_NAME=CloudStudent
# Clé privée du compte de service (JSON field "private_key"), sur UNE ligne avec \n littéraux :
GMAIL_SA_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- Relances automatiques des fiches (étudiant / entreprise) ---
# Un rappel part 72 h après l'envoi du lien s'il n'a pas été soumis (2 relances max).
# Le balayage tourne dans le processus serveur : "off" le désactive (cron externe).
RELANCE_AUTO=on
# Secret du déclencheur externe : POST /api/cron/relances avec l'en-tête x-cron-key.
# Laissé vide, l'endpoint répond 404.
CRON_SECRET=

# --- Misc ---
TZ=Europe/Paris
