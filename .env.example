# --- App ---
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
APP_URL=http://localhost:3000
PUBLIC_APP_NAME="CloudStudent"

# --- Database ---
DATABASE_URL=postgres://app:password@localhost:5432/cloudstudent

# --- Postgres (used by docker-compose) ---
POSTGRES_USER=app
POSTGRES_PASSWORD=password
POSTGRES_DB=cloudstudent
POSTGRES_DATA_DIR=./data/postgres

# --- BetterAuth ---
BETTER_AUTH_SECRET=change-me-to-a-32-char-random-string
BETTER_AUTH_URL=http://localhost:3000

# --- Misc ---
TZ=Europe/Paris
