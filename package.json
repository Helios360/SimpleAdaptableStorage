{
  "name": "simpleadaptablestorage",
  "version": "2.0.0",
  "description": "Candidate management platform for training organizations",
  "type": "module",
  "scripts": {
    "dev": "vite dev --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "start": "bun ./build/index.js",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "bun run src/lib/server/db/migrate.ts",
    "db:seed": "bun run src/lib/server/db/seed.ts"
  },
  "dependencies": {
    "better-auth": "^1.2.7",
    "drizzle-orm": "^0.36.4",
    "nodemailer": "^7.0.13",
    "openai": "^5.20.1",
    "pdf-lib": "^1.17.1",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "^5.2.13",
    "@sveltejs/kit": "^2.43.6",
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@types/bun": "^1.3.4",
    "@types/nodemailer": "^7.0.4",
    "drizzle-kit": "^0.30.6",
    "svelte": "^5.45.0",
    "svelte-check": "^4.4.5",
    "typescript": "^5.9.3",
    "vite": "^6.4.0"
  }
}
